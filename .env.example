# Microsoft 365 Copilot Integration Configuration
# To enable Microsoft 365 Copilot integration, you need to:
# 1. Register an application in Azure Portal (https://portal.azure.com)
# 2. Go to Azure Active Directory > App registrations > New registration
# 3. Set redirect URI to your application URL (e.g., http://localhost:3000)
# 4. Copy the Application (client) ID and paste it below

NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-client-id-here

# Optional: If you're using a specific tenant
# NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id-here

# Database URL for Neon (if using database features)
# DATABASE_URL=postgresql://username:password@neon-host-url/dbname?sslmode=require